rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Pasta plana por utilizador para anexos de tarefas
    match /attachments/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet|image/jpeg|image/png');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
