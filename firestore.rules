rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: cada utilizador acede apenas aos seus dados
    // Admins podem ler qualquer utilizador (para o painel admin)
    match /users/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      allow write: if request.auth != null && request.auth.uid == uid;

      match /tarefas/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /habitos/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /eventos/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /metas/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /decisoes/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Teams: qualquer autenticado pode LER (para encontrar equipa pelo código ao entrar)
    // Escrita protegida: só membros ou quem se está a adicionar
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.membrosUids;
      allow update: if request.auth != null &&
        (request.auth.uid in resource.data.membrosUids ||
         request.auth.uid in request.resource.data.membrosUids);
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.criadoPor;

      match /tarefas/{taskId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.membrosUids;
      }
      match /atividade/{entryId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.membrosUids;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.membrosUids;
        allow update, delete: if false;
      }
    }

    // Referrals: qualquer utilizador autenticado pode ler (para validar código)
    // Só o dono pode criar o seu próprio código
    match /referrals/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;

      match /conversoes/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Vouchers: totalmente bloqueados no frontend (apenas Cloud Functions)
    match /vouchers/{code} {
      allow read, write: if false;
    }

    // Config global (feature flags) — qualquer utilizador pode LER, só admins escrevem
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins: cada admin pode ler o seu proprio registo (para verificacao UI)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
